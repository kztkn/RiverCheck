{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "domain/**/*",
    "server/**/*.server.ts",
    "types/**/*",
    "workers/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["vite/client"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@domain/*": ["./domain/*"],
      "@server/*": ["./server/*"],
      "@shared-types/*": ["./types/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
