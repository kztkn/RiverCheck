{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivercheck",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6bfb9638ee31438bbbbd216c83921b21",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/rivercheck"
    }
  ]
}
